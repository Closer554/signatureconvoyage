# URL publique du site, à définir avant le build pour les aperçus de partage
NEXT_PUBLIC_SITE_URL=https://signature-convoyage.fr

# Clé privée créée dans le tableau de bord Resend
RESEND_API_KEY=re_xxxxxxxxx

# Expéditeur utilisant un domaine vérifié dans Resend
RESEND_FROM_EMAIL="Signature Convoyage <devis@example.com>"

# Un ou plusieurs destinataires, séparés par des virgules
RESEND_TO_EMAIL=contact@example.com
